{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run db:push && npm run create-admin",
    "startCommand": "npm run start",
    "healthcheckPath": "/api/health"
  }
}
